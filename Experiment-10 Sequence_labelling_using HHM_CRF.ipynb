        "sentence = [\"Anna\", \"university\", \"placement\", \"cell\"]\n",
        "labels = [\"B-ORG\", \"I-ORG\", \"I-ORG\", \"I-ORG\"]\n",
        "\n",
        "print(\"Sentence and labels:\\n\")\n",
        "\n",
        "for word, label in zip(sentence, labels):\n",
